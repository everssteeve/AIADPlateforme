# AIAD Plateforme — Variables d'environnement
# Copier ce fichier en .env.local (développement) ou .env.test (tests d'intégration)
# Ne jamais committer les fichiers .env avec de vraies valeurs.

# ─── Supabase ───────────────────────────────────────────────────────────────
# Récupérer depuis : https://supabase.com/dashboard/project/<ref>/settings/api
# En local (supabase start) : http://127.0.0.1:54321
SUPABASE_URL=http://127.0.0.1:54321

# Clé publique (anon) — safe côté client, soumise aux RLS policies
SUPABASE_ANON_KEY=your-anon-key-here

# Clé service role — JAMAIS exposée côté client, bypass RLS
# Utiliser uniquement dans les Server Actions / API Routes / tests d'intégration
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Connexion directe PostgreSQL (pour tests d'intégration avec node-postgres)
# En local : postgresql://postgres:postgres@127.0.0.1:54322/postgres
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# ─── Next.js ────────────────────────────────────────────────────────────────
# URL publique de l'application (utilisée pour les redirects OAuth, emails)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── Anthropic (v2 uniquement — différé par ADR-001) ────────────────────────
# Ne pas activer en v1 — voir .aiad/adrs/ADR-001-llm-differe-v2.md
# ANTHROPIC_API_KEY=your-anthropic-key-here
